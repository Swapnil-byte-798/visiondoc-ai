# ===========================================================================
# VisionDoc AI — environment variables (copy to .env and fill in)
# `.env` is git-ignored. Loaded via python-dotenv / pydantic-settings.
# All values below are placeholders / safe defaults.
# ===========================================================================

# --- Experiment tracking (optional) ---------------------------------------
# Leave WANDB_MODE=offline to log locally without an account/API key.
WANDB_MODE=offline
WANDB_PROJECT=visiondoc-ai
WANDB_API_KEY=

# --- Hugging Face ---------------------------------------------------------
# Only needed for gated models or to raise rate limits. Qwen2.5-VL is public.
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# --- Model / data selection (override config defaults) --------------------
VISIONDOC_CONFIG=configs/default.yaml
VISIONDOC_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
VISIONDOC_DEVICE=auto        # auto | cuda | mps | cpu

# --- API server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Path to a trained LoRA adapter the API should load on startup (optional).
VISIONDOC_ADAPTER_PATH=

# --- OCR fallback ---------------------------------------------------------
# Path to the tesseract binary if not on PATH (e.g. /opt/homebrew/bin/tesseract)
TESSERACT_CMD=
