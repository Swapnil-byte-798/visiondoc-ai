# ===========================================================================
# VisionDoc AI — Docker build-context exclusions
# ---------------------------------------------------------------------------
# The build context is the repo root (compose sets `context: ..`). Excluding
# large / regenerable / secret paths keeps the context small, so `docker build`
# uploads fast and secrets never leak into an image layer.
# NOTE: paths are relative to the build context (repo root), not to docker/.
# ===========================================================================

# --- Version control -------------------------------------------------------
.git
.gitignore
.github

# --- Python caches / build artifacts --------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Virtual environments (never ship a host venv into the image) ----------
.venv/
venv/
env/
.python-version

# --- Secrets / local env ---------------------------------------------------
# .env is loaded at runtime via env_file, NOT baked into the image.
.env
*.pem
*.key

# --- Datasets & caches (regenerated by scripts, mounted as volumes) --------
data/raw/
data/processed/
data/cache/
**/.cache/

# --- Model checkpoints, adapters, and exported weights ---------------------
checkpoints/
outputs/
runs/
adapters/
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# --- Experiment tracking ---------------------------------------------------
wandb/
mlruns/
lightning_logs/

# --- Generated reports / figures ------------------------------------------
reports/*.html
reports/*.json
assets/generated/

# --- OS / editor cruft -----------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- Docker's own files (not needed inside the image) ----------------------
docker/README.md
