# ---------------------------------------------------------------------------
# VisionDoc AI — .gitignore
# Keep the repo lean: never commit datasets, model weights, or secrets.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
.python-version

# Secrets / environment
.env
*.pem
*.key

# ---------------------------------------------------------------------------
# Data & artifacts (large binaries — reproduced by scripts, not versioned)
# ---------------------------------------------------------------------------
data/raw/
data/processed/
data/cache/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Model checkpoints & adapters
checkpoints/
outputs/
runs/
*.safetensors
*.bin
*.onnx
*.pt
*.pth
adapters/

# Experiment tracking
wandb/
mlruns/
lightning_logs/

# Reports / generated figures (regenerated by evaluation pipeline)
reports/*.html
reports/*.json
assets/generated/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
